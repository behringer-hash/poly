# Настройки сервера записи. Копия этого файла лежит в /home/lab/lab.env — правьте её, а не этот пример.
REPO_URL=git@github.com:behringer-hash/poly.git
BRANCH=claude/peaceful-mendel-yvwgus      # ветка с кодом и заданиями (jobs/)
RESULTS_BRANCH=server-results             # ветка, куда сервер кладёт маленькие отчёты
REPO_DIR=/home/lab/poly
RESULTS_DIR=/home/lab/poly-results
DATA_DIR=/home/lab/data                   # сырые данные (в репозиторий НЕ попадают)
STATE_DIR=/home/lab/state
PYTHON=/home/lab/venv/bin/python
JOB_TIMEOUT=1800                          # секунд на одно задание
KEEP_DAYS=14                              # сырые данные старше N дней удаляются
RESULTS_KEEP_DAYS=30                      # отчёты старше N дней удаляются из ветки результатов
